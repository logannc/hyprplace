#!/usr/bin/env lua
-- hyprplace CLI. Read-only inspection tools.
--
-- These NEVER dispatch to a compositor and never mutate anything. `fingerprint` does not
-- even open the state file. Safe to run against a live session.
--
--   hyprplace fingerprint      what hyprplace sees, and what a close would record
--   hyprplace plan             where each open window would be placed right now
--   hyprplace db               current learned state, newest first
--   hyprplace diff             where learned state and reality disagree
--   hyprplace prune            entries the TTL would drop (--apply to write)
--   hyprplace watch            live feed of window changes and hyprplace verdicts
--
-- watch reports a title change only when it changes the window's identity -- a tag
-- appearing, changing or being lost. --titles reports all of them, which in a browser
-- means one per page load.
--
-- watch polls. It cannot observe a change that is reverted inside one interval, and it
-- sees windows only after the compositor has placed them, never at window.open_early.
-- For ground truth about what the plugin actually did, read its own log output.
--
-- The plugin publishes the configuration it resolved to a cache file at config load,
-- and these tools read it. Without that they would run on defaults and report a
-- different verdict from the plugin the moment any option is set. If the cache is
-- absent -- the plugin has never loaded, or was never installed -- they fall back to
-- defaults and say so.
--
--   --instance SIG   target another Hyprland instance (e.g. the test compositor)
--   --runtime DIR    XDG_RUNTIME_DIR for that instance
--   --db PATH        state file to read (default: config's db_path)
--   --config PATH    config cache to read (default: config's cache_path)
--   --no-config      ignore the cache and use built-in defaults

local script = debug.getinfo(1, "S").source:sub(2)
local ROOT = script:match("^(.*)/bin/[^/]*$") or "."

table.insert(package.searchers, 2, function(name)
    local rel = (name == "hyprplace") and "init" or name:match("^hyprplace%.(.+)$")
    if not rel then return nil end
    local path = ROOT .. "/" .. rel:gsub("%.", "/") .. ".lua"
    local chunk = loadfile(path)
    if chunk then return chunk, path end
    return "\n\tno file '" .. path .. "'"
end)

local CLI    = require("hyprplace.cli")
local Cache  = require("hyprplace.cache")
local Config = require("hyprplace.config")
local DB     = require("hyprplace.db")

-- ------------------------------------------------------------------------------- args

local function parse_args(argv)
    local opts, cmd = {}, nil
    local i = 1
    while i <= #argv do
        local a = argv[i]
        if a == "--instance" or a == "-i" then i = i + 1; opts.instance = argv[i]
        elseif a == "--runtime"           then i = i + 1; opts.runtime  = argv[i]
        elseif a == "--db"                then i = i + 1; opts.db       = argv[i]
        elseif a == "--config"            then i = i + 1; opts.config   = argv[i]
        elseif a == "--no-config"         then opts.no_config = true
        elseif a == "--apply"             then opts.apply = true
        elseif a == "--interval"          then i = i + 1; opts.interval = tonumber(argv[i])
        elseif a == "--titles"            then opts.titles = true
        elseif a == "-h" or a == "--help" then opts.help = true
        elseif not cmd                    then cmd = a
        else io.stderr:write("unknown argument: " .. a .. "\n"); os.exit(2)
        end
        i = i + 1
    end
    return cmd, opts
end

local function usage()
    io.write([[
usage: hyprplace <command> [options]

  fingerprint   what hyprplace sees for each open window, and what closing it
                would record. Reads no state and writes none.
  plan          where each open window would be placed if it opened right now.
                Reads the state file; writes nothing.
  db            current learned state, newest first.
  diff          where the learned state and the current layout disagree.
  prune         entries the TTL would drop today. Dry run unless --apply.
  watch         poll for window changes and print what hyprplace would do.
                Ctrl-C to stop. Note a poller cannot see a change that is
                undone within one interval.

options:
  -i, --instance SIG   target another Hyprland instance
      --runtime DIR    XDG_RUNTIME_DIR for that instance
      --db PATH        state file to read
      --config PATH    config cache to read
      --no-config      ignore the cache; report against built-in defaults
      --apply          prune only: actually write the pruned state
      --interval SEC   watch only: poll interval (default 0.25)
      --titles         watch only: report every title change, not just the ones
                       that change a window's identity

These tools read the configuration the running plugin resolved, so their verdicts match
its behaviour. `db` prints which config it used; if the plugin has never loaded there is
no cache and they fall back to defaults.

Every command except `prune --apply` is read-only: they never dispatch to the compositor.
]])
end

local function die(msg)
    io.stderr:write("hyprplace: " .. msg .. "\n")
    os.exit(1)
end

local function windows_or_die(opts)
    local w, err = CLI.load_windows(opts)
    if not w then die(err) end
    return w
end

-- --------------------------------------------------------------------------- commands

local commands = {}

function commands.fingerprint(cfg, opts)
    local windows = windows_or_die(opts)
    local rows = CLI.fingerprint_rows(windows, cfg)
    io.write(string.format("%d open window(s). No state was read or written.\n\n", #rows))
    for _, r in ipairs(rows) do
        io.write(string.format("%-24s ws %-4s pid %-7s %s\n",
            r.class, tostring(r.ws or "-"), tostring(r.pid or "-"),
            r.tracked and "" or ("SKIPPED: " .. tostring(r.reason))))
        io.write(string.format("    title  %s\n", tostring(r.title or "")))
        io.write(string.format("    key    %s   (tier: %s)\n", CLI.show_key(r.key), r.tier))
        if r.would_record then
            io.write(string.format("    record %s -> workspace %d\n",
                CLI.show_key(r.key), r.would_record))
        else
            io.write("    record nothing\n")
        end
        io.write("\n")
    end
end

function commands.plan(cfg, opts)
    local windows = windows_or_die(opts)
    local state = DB.load(cfg.db_path)
    local rows = CLI.plan_rows(windows, state, cfg)
    io.write(string.format("state: %s\n\n", cfg.db_path))
    for _, r in ipairs(rows) do
        io.write(string.format("%-6s %-24s %s\n", r.outcome, r.class, r.detail))
        io.write(string.format("       key %s\n", CLI.show_key(r.key)))
        if r.remembered and #r.remembered > 0 then
            local ws = {}
            for _, id in ipairs(r.remembered) do ws[#ws + 1] = tostring(id) end
            io.write(string.format("       remembered: %s\n", table.concat(ws, ", ")))
        end
    end
end

function commands.db(cfg, _)
    local state = DB.load(cfg.db_path)
    local rows = CLI.db_rows(state, cfg, os.time())
    io.write(string.format("state:  %s\nconfig: %s\n%d entr%s, ttl %d days\n\n",
        cfg.db_path, cfg._source or "?", #rows, #rows == 1 and "y" or "ies",
        cfg.ttl_days))
    for _, r in ipairs(rows) do
        local ws = {}
        for _, id in ipairs(r.workspaces) do ws[#ws + 1] = tostring(id) end
        io.write(string.format("%-44s ws %-12s seen %.1fd ago%s\n",
            CLI.show_key(r.key), table.concat(ws, ","), r.age_days,
            r.expires_in and string.format(", expires in %.1fd", r.expires_in) or ""))
    end
end

function commands.diff(cfg, opts)
    local windows = windows_or_die(opts)
    local state = DB.load(cfg.db_path)
    local rows = CLI.diff_rows(windows, state, cfg)
    io.write(string.format("state: %s\n\n", cfg.db_path))
    local function show(list)
        local out = {}
        for _, id in ipairs(list or {}) do out[#out + 1] = tostring(id) end
        return #out > 0 and table.concat(out, ",") or "-"
    end
    for _, r in ipairs(rows) do
        io.write(string.format("%-10s %-44s remembered %-16s live %s\n",
            r.status, CLI.show_key(r.key), show(r.remembered), show(r.actual)))
    end
end

function commands.prune(cfg, opts)
    local state = DB.load(cfg.db_path)
    local rows = CLI.expired_rows(state, cfg, os.time())
    if cfg.ttl_days <= 0 then
        io.write("ttl is disabled (ttl_days = 0); nothing expires\n")
        return
    end
    io.write(string.format("state: %s\nttl %d days\n\n", cfg.db_path, cfg.ttl_days))
    if #rows == 0 then
        io.write("nothing has expired\n")
        return
    end
    for _, r in ipairs(rows) do
        io.write(string.format("%-44s last seen %.1f days ago\n", CLI.show_key(r.key), r.age_days))
    end
    if not opts.apply then
        io.write(string.format("\n%d entr%s would be dropped. Re-run with --apply to write.\n",
            #rows, #rows == 1 and "y" or "ies"))
        return
    end
    local _, dropped = DB.prune(state, cfg.ttl_days, os.time())
    local written, err = DB.save(cfg.db_path, state)
    if not written then die("could not write state: " .. tostring(err)) end
    io.write(string.format("\ndropped %d entr%s\n", dropped, dropped == 1 and "y" or "ies"))
end

--- Sleep, returning false if the wait was interrupted.
---
--- Deliberately io.popen and not os.execute. os.execute uses system(3), which per POSIX
--- ignores SIGINT and SIGQUIT in the *calling* process for the child's lifetime -- and
--- since watch spends essentially all its time in here, Ctrl-C could never reach us.
--- popen has no such behaviour, so the interrupt lands on the read.
local function nap(seconds)
    local pipe = io.popen("sleep " .. tostring(seconds))
    if not pipe then
        return true
    end
    local ok = pcall(function() pipe:read("a") end)
    pcall(function() pipe:close() end)
    return ok
end

function commands.watch(cfg, opts)
    -- Default well under human reaction time. A poller is blind to any change that is
    -- undone within one interval: moving a window and moving it straight back looks
    -- identical to nothing happening. At 1s that was easy to hit by hand. Polling costs
    -- about a millisecond of CPU, so the interval can be short.
    local interval = opts.interval or 0.25
    local state = DB.load(cfg.db_path)
    io.write(string.format("watching every %ss; state: %s\nCtrl-C to stop.\n\n",
        tostring(interval), cfg.db_path))

    -- Polling rather than tailing the event socket: Lua has no AF_UNIX support and the
    -- alternative would be a dependency on socat or python. The cost is latency, which
    -- does not matter for an observational tool -- but note this sees windows only
    -- *after* the compositor has placed them, not at window.open_early.
    local previous = nil
    while true do
        local windows, err = CLI.load_windows(opts)
        if not windows then die(err) end
        local delta = CLI.window_delta(previous, windows)

        -- Placement verdicts are computed over the FULL window list: how many other
        -- windows of the same app are already on a workspace is exactly what decides
        -- whether a remembered slot is free.
        local plan_by_addr = {}
        if #delta.appeared > 0 then
            for _, r in ipairs(CLI.plan_rows(windows, state, cfg)) do
                plan_by_addr[r.address] = r
            end
        end

        for _, w in ipairs(delta.appeared) do
            local r = plan_by_addr[w.address]
            io.write(string.format("+ %-18s ws %-4s %s\n",
                w.class or "?", tostring(w.workspace and w.workspace.id or "-"),
                CLI.short_title(w.title)))
            if r then
                io.write(string.format("    place  %-6s %s\n", r.outcome, r.detail))
                io.write(string.format("    key    %s\n", CLI.show_key(r.key)))
                if r.remembered then
                    io.write(string.format("    slots  %s\n", CLI.show_list(r.remembered)))
                end
            end
        end

        for _, m in ipairs(delta.moved) do
            local w = m.window
            io.write(string.format("~ %-18s ws %s -> %s  %s\n",
                w.class or "?", tostring(m.from), tostring(m.to), CLI.short_title(w.title)))
            local rec = CLI.would_record(w, windows, m.to, cfg)
            io.write(string.format("    key    %s\n", CLI.show_key(rec.key)))
            if rec.distribution then
                io.write(string.format("    learn  %s   (%d window%s)\n",
                    CLI.show_list(rec.distribution), #rec.distribution,
                    #rec.distribution == 1 and "" or "s"))
            else
                io.write(string.format("    learn  nothing (%s)\n", tostring(rec.reason)))
            end
        end

        -- Title changes are constant noise -- every page load in every browser tab --
        -- so only the ones that change the window's identity are shown by default.
        -- That is exactly the event the Firefox extension produces: a window appears
        -- untagged and is tagged a moment later.
        for _, r in ipairs(delta.retitled) do
            if r.tagged or opts.titles then
                local w = r.window
                io.write(string.format("T %-18s %s -> %s\n", w.class or "?",
                    tostring(r.from_tag or "(untagged)"),
                    tostring(r.to_tag or "(untagged)")))
                io.write(string.format("    title  %s\n", CLI.short_title(r.to)))
                if r.tagged then
                    -- The identity changed, so what the plugin would do changed too.
                    local rec = CLI.would_record(w, windows,
                        w.workspace and w.workspace.id, cfg)
                    io.write(string.format("    key    %s\n", CLI.show_key(rec.key)))
                end
            end
        end

        for _, w in ipairs(delta.vanished) do
            io.write(string.format("- %-18s closed from ws %s  %s\n",
                w.class or "?", tostring(w.workspace and w.workspace.id or "-"),
                CLI.short_title(w.title)))
            -- Computed against the previous snapshot: by now the window is gone, but
            -- the plugin sees it at close time.
            local rec = CLI.would_record(w, previous or {}, w.workspace and w.workspace.id, cfg)
            io.write(string.format("    key    %s\n", CLI.show_key(rec.key)))
            if rec.distribution then
                io.write(string.format("    learn  %s   (%d window%s)\n",
                    CLI.show_list(rec.distribution), #rec.distribution,
                    #rec.distribution == 1 and "" or "s"))
            else
                io.write(string.format("    learn  nothing (%s)\n", tostring(rec.reason)))
            end
        end
        io.flush()

        previous = windows
        if not nap(interval) then
            io.write("\nstopped\n")
            io.flush()
            return
        end
    end
end

-- ------------------------------------------------------------------------------- main

local cmd, opts = parse_args(arg)
if opts.help or not cmd then
    usage()
    os.exit(opts.help and 0 or 2)
end

local handler = commands[cmd]
if not handler then
    io.stderr:write("unknown command: " .. cmd .. "\n\n")
    usage()
    os.exit(2)
end

-- Resolve config the way the plugin did, so the verdicts match.
local overrides, source = {}, "built-in defaults"
if not opts.no_config then
    local cache_path = opts.config or Config.defaults().cache_path
    local cached = Cache.load(cache_path)
    if cached then
        overrides, source = cached, cache_path
    end
end
if opts.db then
    overrides.db_path = opts.db
end
local cfg = Config.build(overrides)
cfg._source = source

handler(cfg, opts)
